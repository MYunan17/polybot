{
  "name": "polymarket-mirofish-bot",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted Polymarket research, calibration, and guarded execution bot",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "scanner": "tsx src/scripts/runScanner.ts",
    "dry-run": "tsx src/scripts/runDryRun.ts",
    "seed": "tsx src/scripts/runSeed.ts",
    "mirofish": "tsx src/scripts/runMirofish.ts",
    "paper": "tsx src/scripts/runPaper.ts",
    "backtest": "tsx src/scripts/runBacktest.ts",
    "inspect-db": "tsx src/scripts/inspectDb.ts",
    "telegram-test": "tsx src/scripts/telegramTest.ts",
    "mirofish-health": "tsx src/scripts/mirofishHealth.ts",
    "debug:mirofish": "tsx src/scripts/debugMirofish.ts",
    "health": "tsx src/scripts/health.ts",
    "full-dry-cycle": "tsx src/scripts/fullDryCycle.ts",
    "production-dry-run": "tsx src/scripts/productionDryRun.ts",
    "openclaw-health": "tsx src/scripts/openclawHealth.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "dotenv": "^16.5.0",
    "p-limit": "^6.1.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "rss-parser": "^3.13.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
